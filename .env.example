# ==============================================================================
# ShopAI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your custom credentials.
# NEVER commit the actual '.env' file to your Git repository!

# ------------------------------------------------------------------------------
# 1. GenAI & LLM Configuration (Groq / OpenAI)
# ------------------------------------------------------------------------------
# Obtain your free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Optional OpenAI API Key for advanced NLP synthesis
OPENAI_API_KEY=sk-your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Vector Search & Embedding Model
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Generate strong 256-bit secrets using: python -c "import secrets; print(secrets.token_hex(32))"
SHOPAI_JWT_SECRET=your_production_jwt_access_secret_key_here_min_32_chars
SHOPAI_JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_key_here_min_32_chars

# ------------------------------------------------------------------------------
# 4. Email & SMTP Delivery (For Real OTP Emails)
# ------------------------------------------------------------------------------
# If left empty, OTPs will be displayed directly in the terminal for local testing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=noreply@shopai.com
SMTP_FROM_NAME="ShopAI Assistant"

# ------------------------------------------------------------------------------
# 5. Server & Networking
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# ------------------------------------------------------------------------------
# 6. Frontend API Gateway (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000
